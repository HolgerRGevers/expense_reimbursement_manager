			(
				type = number
				displayname = "Tier Order"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Dual_Approval
			(
    			type = checkbox
				displayname = "Requires Dual Approval"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Dual_Approval_Role
			(
    			type = text
				displayname = "Duap Approval Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Approval Threshold Created","Approval Threshold Validated","Approval Threshold Rejected","Dual Approval Rule Enforced","Approval Threshold Activated","Approval Threshold Updated","Claim Submitted for Approval","Approval Threshold Deactivated","First Approval Pending","Claim Rejected at Submission","Second Approval Required","First Approval Approved","Claim Rejected by First Approver","Second Approval Pending","Claim Approved","Claim Rejected by Second Approver","Claim Processed","Claim Reopened for Review","Claim Closed"}
			}
		}
