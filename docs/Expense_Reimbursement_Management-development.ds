 application "Expense Reimbursement Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form approval_history
		{
			displayname = "Approval History"
			success message = "Approval History Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim
			(
				type = list	
				displayname = "Claim"
				values  = expense_claims.ID
    			displayformat = [Email]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_1
			(
				type = picklist
				displayname = "Action 1"
				values = {"Submitted","Escalated (SLA Breach)","Warning","Rejected (Key 2)","Reconsidered (Key 1)","Approved (HoD)","Approved (Key 2)","Approved (Key 1)","Submitted (Self-approval bypass)","Rejected","Resubmitted","Approved (LM)"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			timestamp
			(
    			type = datetime
				displayname = "Timestamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			actor_role
			(
    			type = text
				displayname = "Actor Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form approval_thresholds
		{
			displayname = "Approval Thresholds"
