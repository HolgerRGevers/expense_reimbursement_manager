		form expense_claims
		{
			displayname = "Expense Claims"
			success message = "Expense Claim Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			Submission_Date
			(
    			type = date
				displayname = "Submission Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Claim_Reference
			(
    			type = text
				displayname = "Claim Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gl_code
			(
				type = list	
				displayname = "GL Code"
				values  = gl_accounts.ID
    			displayformat = [gl_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Training","Travel","Utilities","Office Supplies","Meals","Marketing","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			VAT_Invoice_Type
			(
				type = picklist
				displayname = "VAT Invoice Type"
				values = {"Full Tax Invoice (>= R5","Partial Tax Invoice (<= R5","None","000)"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","Draft","Pending HoD Approval","Pending Second Key","Key 2 Dispute","Approved","Rejected","Resubmitted","Pending LM Approval"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supporting_Documents
			(
    			type = text
				displayname = "Supporting Documents"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Retention_Expiry_Date
			(
