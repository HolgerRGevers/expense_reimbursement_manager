	reports
	{
		list expense_claims_Report
		{
			displayName = "All Expense Claims"
			show all rows from expense_claims    
			(
				Email
				Submission_Date as "Submission Date"
				Claim_Reference as "Claim Reference"
				gl_code as "GL Code"
				category as "Category"
				VAT_Invoice_Type as "VAT Invoice Type"
				status as "Status"
				Supporting_Documents as "Supporting Documents"
				Retention_Expiry_Date as "Retention Expiry Date"
				Claim_Submission_Timestamp as "Claim Submission Timestamp"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (VAT_Invoice_Type == "000)")
				fields = [VAT_Invoice_Type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (VAT_Invoice_Type == "Full Tax Invoice (>= R5")
				fields = [VAT_Invoice_Type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (VAT_Invoice_Type == "Partial Tax Invoice (<= R5")
				fields = [VAT_Invoice_Type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban expense_claims_by_status
		{
			displayName = "Statuses"
			show all rows from expense_claims    
			(
				Email
				Submission_Date as "Submission Date"
				Claim_Reference as "Claim Reference"
				gl_code as "GL Code"
				category as "Category"
				VAT_Invoice_Type as "VAT Invoice Type"
				status as "Status"
				Supporting_Documents as "Supporting Documents"
				Retention_Expiry_Date as "Retention Expiry Date"
				Claim_Submission_Timestamp as "Claim Submission Timestamp"
			)
			options
			(
	 			display field = status
	 		)
		}
		list gl_accounts_Report
		{
			displayName = "All Gl Accounts"
			show all rows from gl_accounts    
			(
				gl_code as "GL Code"
				account_name as "Account Name"
				expense_category as "Expense Category"
				receipt_required as "Receipt Required"
				SARS_Provision as "SARS Provision"
				Risk_Level as "Risk Level"
				Active
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (Risk_Level == "High")
				fields = [Risk_Level]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (Risk_Level == "Low")
				fields = [Risk_Level]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (Risk_Level == "Medium")
				fields = [Risk_Level]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban gl_accounts_by_expense_category
		{
			displayName = "Expense Categories"
			show all rows from gl_accounts    
			(
				gl_code as "GL Code"
				account_name as "Account Name"
				expense_category as "Expense Category"
				receipt_required as "Receipt Required"
				SARS_Provision as "SARS Provision"
				Risk_Level as "Risk Level"
				Active
			)
			options
			(
	 			display field = expense_category
	 		)
		}
		list approval_history_Report
		{
			displayName = "All Approval Histories"
			show all rows from approval_history    
			(
				claim as "Claim"
				action_1 as "Action 1"
				timestamp as "Timestamp"
				actor_role as "Actor Role"
				notes as "Notes"
			)
		}
		list departments_Report
		{
			displayName = "All Departments"
			show all rows from departments    
			(
				department_name as "Department Name"
				manager_name as "Manager Name"
			)
		}
		list approval_thresholds_Report
		{
			displayName = "All Approval Thresholds"
			show all rows from approval_thresholds    
			(
				tier_name as "Tier Name"
				approver_role as "Approver Role"
				Active
				Tier_Order as "Tier Order"
				Requires_Dual_Approval as "Requires Dual Approval"
				Dual_Approval_Role as "Duap Approval Role"
			)
		}
		list clients_Report
		{
			displayName = "All Clients"
			show all rows from clients    
			(
				client_name as "Client Name"
				contact_person as "Contact Person"
				email as "Email"
			)
		}
	}
